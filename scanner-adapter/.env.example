# Cisco Skill Scanner API address. Keep this service on localhost or a private network.
SCANNER_API_BASE_URL=http://localhost:8000
SCANNER_SCAN_PATH=/scan-upload
SCANNER_HEALTH_PATH=/health
SCANNER_ANALYZERS_PATH=/analyzers

# Synchronous HTTP timeouts and the documented upload ceiling.
SCANNER_CONNECT_TIMEOUT_SECONDS=5
SCANNER_READ_TIMEOUT_SECONDS=300
SCANNER_MAX_ZIP_BYTES=52428800

# Analyzer request options.
SCANNER_USE_BEHAVIORAL=true
SCANNER_USE_LLM=false
SCANNER_LLM_PROVIDER=openai
SCANNER_USE_AI_DEFENSE=false
SCANNER_POLICY=balanced

# SKILL_SCANNER_LLM_API_KEY, SKILL_SCANNER_LLM_BASE_URL, and
# SKILL_SCANNER_LLM_MODEL are configured on the scanner container, not this adapter.
# AI_DEFENSE_API_KEY is configured on the scanner container, not this adapter.
