# SkillHub Secret example.
# Copy this file to secret.yaml and replace the placeholder values before applying.
#
# cp secret.yaml.example secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: skillhub-secret
type: Opaque
stringData:
  # PostgreSQL credentials used by overlays/with-infra.
  postgres-username: skillhub
  postgres-password: change-me

  # PostgreSQL SQLAlchemy async URL used by the Python backend.
  # URL-encode special characters in the username or password.
  database-url: postgresql+asyncpg://skillhub:change-me@postgres:5432/skillhub

  # Bootstrap admin password.
  bootstrap-admin-password: ChangeMe!2026

  # GitHub OAuth provider. Leave empty to keep the provider disabled/deferred.
  oauth2-github-client-id: ""
  oauth2-github-client-secret: ""

  # GitLab OAuth provider. Leave empty to keep the provider disabled/deferred.
  oauth2-gitlab-client-id: ""
  oauth2-gitlab-client-secret: ""

  # Scanner LLM configuration.
  skill-scanner-llm-api-key: ""
  skill-scanner-llm-base-url: ""
  skill-scanner-llm-model: ""
