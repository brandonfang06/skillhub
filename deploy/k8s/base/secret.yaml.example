# SkillHub Secret example.
# Copy this file to secret.yaml and replace the placeholder values before applying.
#
# cp secret.yaml.example secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: skillhub-secret
type: Opaque
stringData:
  # PostgreSQL SQLAlchemy async URL used by the Python backend.
  # URL-encode special characters in the username or password.
  database-url: postgresql+asyncpg://skillhub:change-me@postgres.example.internal:5432/skillhub

  # Redis password used by SPRING_DATA_REDIS_PASSWORD. Leave empty when Redis
  # has no password. The Python backend also supports redis-url below as an
  # optional full override.
  redis-username: ""
  redis-password: change-me
  redis-sentinel-username: ""
  redis-sentinel-password: ""
  # Optional Redis URL override. If this is non-empty it takes precedence over
  # redis-host / redis-port / redis-password / redis-database from the manifests.
  # Format without password: redis://redis.example.internal:6379/0
  # Format with password: redis://:password@redis.example.internal:6379/0
  redis-url: ""

  # External MinIO / S3 credentials.
  storage-s3-access-key: skillhub
  storage-s3-secret-key: change-me

  # Bootstrap admin password.
  bootstrap-admin-password: ChangeMe!2026

  # Keycloak / OIDC provider. Leave empty to keep the provider disabled/deferred.
  oauth2-keycloak-client-id: ""
  oauth2-keycloak-client-secret: ""

  # Backend-to-scanner AI Defense header. This is separate from the scanner LLM
  # API key below, which belongs to the scanner container.
  scanner-ai-defense-api-key: ""

  # Scanner LLM configuration.
  skill-scanner-llm-api-key: ""
  skill-scanner-llm-base-url: ""
  skill-scanner-llm-model: ""
