# Local development overrides for Docker dependencies and `uv run uvicorn`.
# Copy this file to `.env.local` and edit values for your machine.
# `.env.local` is intentionally ignored by git.
#
# Keep this file shell-compatible: KEY=value, no spaces around `=`.
# Quote values only when your shell requires it.

# Dependency container images used by docker-compose.yml.
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:latest

# Local PostgreSQL dependency and Python backend connection.
POSTGRES_DB=skillhub
POSTGRES_USER=skillhub
POSTGRES_PASSWORD=skillhub_dev
SKILLHUB_DATABASE_URL=postgresql+asyncpg://skillhub:${POSTGRES_PASSWORD}@localhost:5432/skillhub

# Local Redis dependency. Leave REDIS_PASSWORD empty for zero-config dev.
REDIS_PASSWORD=
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=${REDIS_PASSWORD}
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_USERNAME=
SPRING_DATA_REDIS_SSL_ENABLED=false

# Optional Redis Sentinel test wiring. Leave blank for normal local Redis.
SKILLHUB_REDIS_URL=
SPRING_DATA_REDIS_SENTINEL_MASTER=
SPRING_DATA_REDIS_SENTINEL_NODES=
SPRING_DATA_REDIS_SENTINEL_USERNAME=
SPRING_DATA_REDIS_SENTINEL_PASSWORD=

# Local MinIO dependency. Backend defaults to local filesystem storage unless
# SKILLHUB_STORAGE_PROVIDER is changed to s3.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
SKILLHUB_STORAGE_PROVIDER=local
SKILLHUB_STORAGE_S3_ENDPOINT=http://localhost:9000
SKILLHUB_STORAGE_S3_PROXY_ENDPOINT=
SKILLHUB_STORAGE_S3_PUBLIC_ENDPOINT=
SKILLHUB_STORAGE_S3_BUCKET=skillhub-packages
SKILLHUB_STORAGE_S3_ACCESS_KEY=minioadmin
SKILLHUB_STORAGE_S3_SECRET_KEY=minioadmin
SKILLHUB_STORAGE_S3_REGION=us-east-1
SKILLHUB_STORAGE_S3_FORCE_PATH_STYLE=true
SKILLHUB_STORAGE_S3_DISABLE_CHUNKED_ENCODING=false
SKILLHUB_STORAGE_S3_AUTO_CREATE_BUCKET=true

# Local auth/bootstrap behavior.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USER_ID=docker-admin
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
BOOTSTRAP_ADMIN_DISPLAY_NAME=Platform Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SKILLHUB_AUTH_DIRECT_ENABLED=false
SKILLHUB_AUTH_SESSION_BOOTSTRAP_ENABLED=false
SKILLHUB_SESSION_COOKIE_SECURE=false
SKILLHUB_PUBLIC_BASE_URL=http://localhost:3000

# Optional Keycloak / OIDC login.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_CLIENT_SECRET=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_PROVIDER=keycloak
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_KEYCLOAK_CLIENT_NAME=Keycloak
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KEYCLOAK_ISSUER_URI=

# Rolling retention for local download analytics events. Set 0 to disable pruning.
SKILLHUB_DOWNLOAD_ANALYTICS_RETENTION_MONTHS=12

# Backend scanner request options.
SKILLHUB_SECURITY_SCANNER_ENABLED=true
SKILLHUB_SECURITY_SCANNER_BASE_URL=http://localhost:8000
SKILLHUB_SECURITY_SCANNER_MODE=upload
SKILLHUB_SCAN_CONSUMER_ENABLED=true
SKILLHUB_SCANNER_USE_BEHAVIORAL=true
SKILLHUB_SCANNER_USE_LLM=false
SKILLHUB_SCANNER_LLM_PROVIDER=anthropic
SKILLHUB_SCANNER_USE_META=false
SKILLHUB_SCANNER_USE_AI_DEFENSE=false
SKILLHUB_SCANNER_AI_DEFENSE_API_KEY=
SKILLHUB_SCANNER_USE_VIRUSTOTAL=false
SKILLHUB_SCANNER_USE_TRIGGER=false

# Scanner container LLM settings.
SKILL_SCANNER_LLM_API_KEY=
SKILL_SCANNER_LLM_BASE_URL=
SKILL_SCANNER_LLM_MODEL=
